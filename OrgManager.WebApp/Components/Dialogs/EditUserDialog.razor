@using System.Net.Http
@using System.Net.Http.Json
@using OrgManager.Application.Features.Users.Commands.UpdateUser
@using OrgManager.Application.Features.Users.Queries.GetAllUsers
@using OrgManager.Core.Domain.Enums

@inject IHttpClientFactory HttpClientFactory

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">ویرایش کاربر</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="success">
            <MudTextField T="string" @bind-Value="User.Username" Label="نام کاربری" Required="true" />
            <MudTextField T="string" @bind-Value="User.Email" Label="ایمیل" Required="true" />
            <MudTextField T="string" @bind-Value="User.FullName" Label="نام کامل" Required="true" />
            <MudTextField T="string" @bind-Value="User.Department" Label="دپارتمان" />
            <MudSelect T="Role" @bind-Value="User.Role" Label="نقش">
                <MudSelectItem Value="Role.RegularUser">کاربر عادی</MudSelectItem>
                <MudSelectItem Value="Role.Admin">ادمین</MudSelectItem>
                <MudSelectItem Value="Role.SuperAdmin">سوپر ادمین</MudSelectItem>
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">لغو</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">ذخیره</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public UserDto User { get; set; }

    private MudForm form;
    private bool success;

    private async Task Submit()
    {
        await form.Validate();
        if (success)
        {
            var command = new UpdateUserCommand
            {
                Id = User.Id,
                Username = User.Username,
                Email = User.Email,
                FullName = User.FullName,
                Department = User.Department,
                Role = User.Role
            };

            var client = HttpClientFactory.CreateClient("OrgManager.Api");
            await client.PutAsJsonAsync($"api/users/{User.Id}", command);
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    void Cancel() => MudDialog.Cancel();
}
