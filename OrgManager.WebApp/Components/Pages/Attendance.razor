@page "/attendance"
@using System.Net.Http
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components.Authorization
@using OrgManager.WebApp.Services
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITimeService TimeService

<MudText Typo="Typo.h4" GutterBottom="true">حضور و غیاب</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CheckIn">ثبت ورود</MudButton>

@if (latestAttendanceRecord != null && latestAttendanceRecord.CheckOutTime == null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="CheckOut">ثبت خروج</MudButton>
}

<MudDataGrid T="AttendanceRecordDto" Items="@attendanceRecords">
    <Columns>
        <PropertyColumn Property="x => TimeService.ToPersianDate(x.CheckInTime)" Title="تاریخ ورود" />
        <PropertyColumn Property="x => TimeService.ToPersianTime(x.CheckInTime)" Title="ساعت ورود" />
        <PropertyColumn Property="x => x.CheckOutTime.HasValue ? TimeService.ToPersianDate(x.CheckOutTime.Value) : """ Title="تاریخ خروج" />
        <PropertyColumn Property="x => x.CheckOutTime.HasValue ? TimeService.ToPersianTime(x.CheckOutTime.Value) : """ Title="ساعت خروج" />
    </Columns>
</MudDataGrid>


@code {
    private List<AttendanceRecordDto> attendanceRecords = new();
    private AttendanceRecordDto? latestAttendanceRecord;

    protected override async Task OnInitializedAsync()
    {
        await LoadAttendanceRecords();
    }

    private async Task LoadAttendanceRecords()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var client = HttpClientFactory.CreateClient("OrgManager.Api");
        // This is a placeholder for the GetAttendanceRecordsQuery
        // var response = await client.GetFromJsonAsync<List<AttendanceRecordDto>>("api/attendance");
        // if (response != null)
        // {
        //     attendanceRecords = response;
        //     latestAttendanceRecord = attendanceRecords.LastOrDefault();
        // }
    }

    private async Task CheckIn()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var client = HttpClientFactory.CreateClient("OrgManager.Api");
        var response = await client.PostAsync("api/attendance/checkin", null);

        if (response.IsSuccessStatusCode)
        {
            await LoadAttendanceRecords();
        }
    }

    private async Task CheckOut()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var client = HttpClientFactory.CreateClient("OrgManager.Api");
        var command = new { AttendanceRecordId = latestAttendanceRecord.Id };
        var response = await client.PostAsJsonAsync("api/attendance/checkout", command);

        if (response.IsSuccessStatusCode)
        {
            await LoadAttendanceRecords();
        }
    }

    public class AttendanceRecordDto
    {
        public Guid Id { get; set; }
        public DateTime CheckInTime { get; set; }
        public DateTime? CheckOutTime { get; set; }
    }
}
