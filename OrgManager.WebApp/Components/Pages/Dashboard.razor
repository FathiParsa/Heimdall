@page "/dashboard"
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]

<AuthorizeView Roles="SuperAdmin">
    <SuperAdminDashboard />
</AuthorizeView>

<AuthorizeView Roles="Admin">
    <AdminDashboard />
</AuthorizeView>

<AuthorizeView Roles="RegularUser">
    <RegularUserDashboard />
</AuthorizeView>
