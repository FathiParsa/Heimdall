@page "/login"
@using System.Net.Http
@using System.Net.Http.Json
@using OrgManager.Application.Features.Users.Commands.Login
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<MudText Typo="Typo.h4" GutterBottom="true">ورود</MudText>

<MudPaper Class="pa-4">
    <MudForm @ref="form" @bind-IsValid="success">
        <MudTextField T="string" @bind-Value="model.Username" Label="نام کاربری" Required="true" RequiredError="نام کاربری اجباری است." />
        <MudTextField T="string" @bind-Value="model.Password" Label="رمز عبور" Required="true" RequiredError="رمز عبور اجباری است." InputType="InputType.Password" />
    </MudForm>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" @onclick="Submit">ورود</MudButton>
</MudPaper>

@code {
    private LoginCommand model = new LoginCommand();
    private MudForm form = new();
    private bool success;

    private async Task Submit()
    {
        await form.Validate();
        if (success)
        {
            var client = HttpClientFactory.CreateClient("OrgManager.Api");
            var response = await client.PostAsJsonAsync("api/users/login", model);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
                // In a real application, you would store the token in a secure way
                // and use it to authenticate subsequent requests.
                Console.WriteLine($"Token: {result.Token}");
                NavigationManager.NavigateTo("/");
            }
        }
    }

    public class LoginResponse
    {
        public string Token { get; set; } = string.Empty;
    }
}
