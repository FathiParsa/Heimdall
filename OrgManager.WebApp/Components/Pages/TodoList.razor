@page "/todolist"
@using System.Net.Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using OrgManager.Application.Features.Todo.Commands.CreateTodoList
@using OrgManager.WebApp.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudText Typo="Typo.h4" GutterBottom="true">لیست کارها</MudText>

<MudButton OnClick="OpenCreateTodoListDialog">ایجاد لیست جدید</MudButton>

@foreach (var list in todoLists)
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">@list.Title</MudText>
        <SortableList Items="list.Items" OnUpdate="@((args) => OnItemDrop(list, args))">
            <SortableItemTemplate>
                <MudPaper Class="pa-2 mt-2">@context.Title</MudPaper>
            </SortableItemTemplate>
        </SortableList>
    </MudPaper>
}

@code {
    private List<TodoListDto> todoLists = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTodoLists();
    }

    private async Task LoadTodoLists()
    {
        var client = HttpClientFactory.CreateClient("OrgManager.Api");
        var response = await client.GetFromJsonAsync<List<TodoListDto>>("api/todo");
        if (response != null)
        {
            todoLists = response;
        }
    }

    private async Task OpenCreateTodoListDialog()
    {
        // Open a dialog to create a new todo list
    }

    private void OnItemDrop(TodoListDto list, (int oldIndex, int newIndex) args)
    {
        var item = list.Items[args.oldIndex];
        list.Items.RemoveAt(args.oldIndex);
        list.Items.Insert(args.newIndex, item);
        StateHasChanged();
    }

    public class TodoListDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public List<TodoItemDto> Items { get; set; } = new();
    }

    public class TodoItemDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
    }
}
